# Icons and the share card almost never change, so stop paying a
# revalidation round trip for them on every visit.
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Crawler-facing text. A day is plenty, and keeps edits picked up quickly.
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400
/llms.txt
  Cache-Control: public, max-age=86400
/llms.md
  Cache-Control: public, max-age=86400

# index.html deliberately keeps its default max-age=0, must-revalidate, so
# copy edits go live immediately. The edge still serves it from cache.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
